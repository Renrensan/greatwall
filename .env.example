## ETHEREUM (and other EVM chains)
# Ethereum Testnet (Sepolia)
ETH_TESTNET_RPC_URL=
ETH_TESTNET_EXPLORER=

# Hyperliquid
HYPERLIQUID_TESTNET_RPC_URL=
HYPERLIQUID_TESTNET_EXPLORER=

# Arbitrum
ARBITRUM_TESTNET_RPC_URL=
ARBITRUM_TESTNET_EXPLORER=

# Base
BASE_TESTNET_RPC_URL=
BASE_TESTNET_EXPLORER=

# Robinhood Chain
ROBINHOOD_TESTNET_RPC_URL=
ROBINHOOD_TESTNET_EXPLORER=

# Tempo
TEMPO_TESTNET_RPC_URL=
TEMPO_TESTNET_EXPLORER=

# SOLANA
# Solana Devnet
SOLANA_DEVNET_RPC_URL=

# The operator node's tunnel API (conversions between two networks), called
# only by this app's server (/api/tunnel). The key is the node's
# tunnel_api.key_env value: never a NEXT_PUBLIC_ variable.
TUNNEL_API_URL=http://127.0.0.1:8787
TUNNEL_API_KEY=

# Greatwall's server faucet (/api/faucet/*): its own test keys, never the
# deployer's or the operator's. One EVM key (0x…) for every EVM test network,
# holding each network's gas coin and a stock of the test tokens; and a Solana
# key (JSON array), the mock RWA mints' authority, holding devnet SOL.
FAUCET_EVM_KEY=
FAUCET_SOLANA_KEY=
# The public origin of this site, for the token list's logo links and the
# metadata URLs written on-chain when a BETA is created (default: the
# request's origin, which behind a proxy is the internal one: set it in
# production).
PUBLIC_ORIGIN=
# BETA metadata and images (the creator's description, links, image): the
# chains keep their URL for good. With a Pinata key they are pinned on IPFS,
# content-addressed, so the URL cannot change meaning and the files outlive
# this server: set this in production (https://app.pinata.cloud, API keys,
# a key with pinFileToIPFS and pinJSONToIPFS).
PINATA_JWT=
# The IPFS gateway in the URLs written on-chain (default: Pinata's public
# gateway; a dedicated gateway is faster for wallets).
IPFS_GATEWAY=
# Without a Pinata key, the files are kept in this directory (default:
# ./data/beta) and served by this site. The ZEC lane keeps its orders here
# too (<dir>/zec), so it must survive a redeploy (a Docker volume).
GREATWALL_DATA_DIR=

# Pay with ZEC (docs/zec-lane.md): the lane's Zcash service (zec-lane/lane.mjs,
# watch-only, on 127.0.0.1) and the key both sides share. Unset, Pay with ZEC
# says it is not set up. Deliveries are sent with FAUCET_SOLANA_KEY.
ZEC_LANE_URL=http://127.0.0.1:8790
ZEC_LANE_API_KEY=
